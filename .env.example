# This file documents only the env vars added alongside the Twilio WhatsApp
# integration (see lib/whatsapp-server.ts). It is NOT a comprehensive list of
# every env var this app uses — most third-party integrations (SMTP, Resend,
# the generic WhatsApp provider, Google OAuth) are configured via Admin
# Settings (stored in the SiteSetting table) with env vars only as a fallback,
# and aren't captured here yet.

# Twilio WhatsApp — real backend for the Reminders feature's WhatsApp channel.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_DEFAULT_CONTENT_SID=
