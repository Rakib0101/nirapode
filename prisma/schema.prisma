generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  USER
}

enum OtpType {
  EMAIL_VERIFICATION
  FORGOT_PASSWORD
  RESET_PIN
}

enum ShareStatus {
  AVAILABLE
  SOLD
  LISTED_FOR_SALE
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

enum PurchaseStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED // ShareListing only: every listed share has been sold
}

enum PaymentMethod {
  BANK_TRANSFER
  BKASH
  NAGAD
  ROCKET
  GCASH
  PAYNOW
  WALLET
}

enum WalletTxType {
  DEPOSIT
  WITHDRAWAL
  SHARE_PURCHASE
  SHARE_SALE
  REFUND
  COMMISSION
  ADMIN_CREDIT
  ADMIN_DEBIT
  CHECKOUT_PAYMENT
  TRANSFER_SENT
  TRANSFER_RECEIVED
  TRANSFER_FEE
  PICKPUT_PAYMENT
  PICKPUT_EARNING
  SERVICE_FEE
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  ASSIGNED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum CheckoutStatus {
  DRAFT
  AWAITING_PAYMENT
  PROOF_SUBMITTED
  PAID
  REJECTED
  CANCELLED
}

enum CheckoutItemType {
  TAXI
  AIR_TICKET
  SERVICE
  CUSTOM
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LostFoundType {
  LOST
  FOUND
}

enum LostFoundStatus {
  OPEN
  RESOLVED
  REMOVED
}

enum NotificationType {
  SYSTEM
  PURCHASE
  WALLET
  TRADE
  OTP
}

enum ApplyStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

// ─────────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  fullName     String
  nidNumber    String?  @unique
  email        String   @unique
  phone        String?
  passwordHash String?
  // Separate from passwordHash — a quick 4-digit app-lock PIN, independent of
  // the account's real login password. Null means the user hasn't opted into
  // the app-lock gate (see lib/session.ts / middleware.ts).
  pinHash      String?
  googleId     String?  @unique
  profilePhoto String?
  role         Role     @default(USER)
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  isAgent      Boolean  @default(false)
  referralCode String?  @unique
  // Set once, permanently, the first time this user signs up or logs in
  // after clicking an agent's referral link — never overwritten afterward.
  // See lib/commission.ts attachReferralIfNeeded().
  referredByAgentId String?
  referredByAgent   User?    @relation("AgentReferrals", fields: [referredByAgentId], references: [id])
  referredUsers     User[]   @relation("AgentReferrals")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  otpTokens            OtpToken[]
  wallet               Wallet?
  sharePurchases       SharePurchaseRequest[]
  referredSharePurchases SharePurchaseRequest[] @relation("SharePurchaseReferrer")
  referredTaxiRequests   TaxiRequest[]          @relation("TaxiReferrer")
  referredAirTicketRequests AirTicketRequest[]  @relation("AirTicketReferrer")
  referredServiceRequests   ServiceRequest[]    @relation("ServiceReferrer")
  shareListings        ShareListing[]
  shareTrades          ShareTrade[]         @relation("BuyerTrades")
  ownedShares          ShareOwnership[]
  depositRequests      DepositRequest[]
  withdrawalRequests   WithdrawalRequest[]
  taxiRequests         TaxiRequest[]
  managedTaxiRequests  TaxiRequest[]          @relation("TaxiManagerAssignment")
  processedTaxiRequests TaxiRequest[]         @relation("TaxiProcessedBy")
  airTicketRequests        AirTicketRequest[]
  managedAirTicketRequests AirTicketRequest[] @relation("AirTicketManagerAssignment")
  processedAirTicketRequests AirTicketRequest[] @relation("AirTicketProcessedBy")
  checkouts            Checkout[]
  createdCheckouts     Checkout[]             @relation("CheckoutCreatedBy")
  processedCheckouts   Checkout[]             @relation("CheckoutProcessedBy")
  serviceRequests      ServiceRequest[]
  blogPosts            Blog[]
  islamicArticles      IslamicArticle[]
  pdfDocuments         PdfDocument[]
  lostFoundPosts       LostFoundPost[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  applyApplications    ApplyApplication[]
  shareCertificates    ShareCertificate[]
  processedPurchases   SharePurchaseRequest[] @relation("PurchaseProcessor")
  processedListings    ShareTrade[]           @relation("TradeProcessor")
  processedDeposits    DepositRequest[]       @relation("DepositProcessor")
  processedWithdrawals WithdrawalRequest[]    @relation("WithdrawalProcessor")
  createdProjects      Project[]
  buyRequests          ShareBuyRequest[]      @relation("BuyRequestBuyer")
  processedBuyRequests ShareBuyRequest[]      @relation("BuyRequestProcessor")
  referredBuyRequests  ShareBuyRequest[]      @relation("BuyRequestReferrer")
  reminders            Reminder[]
  forumTopics          ForumTopic[]
  forumReplies         ForumReply[]
  sentTransfers              WalletTransfer[]       @relation("TransferSender")
  receivedTransfers          WalletTransfer[]       @relation("TransferRecipient")
  pickPutTrips               PickPutTrip[]
  pickPutBookings            PickPutBooking[]

  @@index([email])
  @@index([nidNumber])
}

model OtpToken {
  id        String   @id @default(cuid())
  userId    String
  email     String
  token     String
  type      OtpType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, token])
}

model PendingRegistration {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  phone        String
  passwordHash String
  otp          String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([email])
}

// ─────────────────────────────────────────────
// SHARE INVESTMENT MARKETPLACE
// ─────────────────────────────────────────────

model Project {
  id               String        @id @default(cuid())
  name             String
  description      String
  imageUrl         String?
  totalShares      Int
  sharePriceSgd    Decimal       @db.Decimal(12, 2) // per-share list price in SGD — actual payment is converted to BDT at purchase time, see lib/share-pricing.ts
  availableShares  Int
  status           ProjectStatus @default(ACTIVE)
  createdById      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  createdBy        User              @relation(fields: [createdById], references: [id])
  shares           ShareOwnership[]
  purchaseRequests SharePurchaseRequest[]
  listings         ShareListing[]
  priceHistory     ProjectPriceHistory[]
  certificates     ShareCertificate[]
}

model ShareCertificate {
  id          String    @id @default(cuid())
  projectId   String
  shareNumber Int
  ownerId     String?   // null = available (not yet assigned)
  issuedAt    DateTime? // set when assigned to an owner
  priceSgd    Decimal?  @db.Decimal(12, 2) // per-share price override in SGD; null = use project.sharePriceSgd
  code        String?   // Optional custom word or alphanumeric identifier (e.g. GOLD-001)

  project Project @relation(fields: [projectId], references: [id])
  owner   User?   @relation(fields: [ownerId], references: [id])

  @@unique([projectId, shareNumber])
  @@index([projectId, ownerId])
}

model ProjectPriceHistory {
  id        String   @id @default(cuid())
  projectId String
  oldPrice  Decimal  @db.Decimal(12, 2)
  newPrice  Decimal  @db.Decimal(12, 2)
  changedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ShareOwnership {
  id            String   @id @default(cuid())
  projectId     String
  ownerId       String
  quantity      Int
  // Average BDT the owner actually paid per share — locked at purchase time,
  // never derived from the project's current price.
  purchasePrice Decimal  @db.Decimal(12, 2)
  acquiredAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  owner   User    @relation(fields: [ownerId], references: [id])

  @@unique([projectId, ownerId])
}

model SharePurchaseRequest {
  id            String         @id @default(cuid())
  buyerId       String
  projectId     String
  quantity      Int
  // The specific admin-created share numbers the buyer picked (quantity is
  // just this array's length). Empty on legacy rows created before this field
  // existed — processPurchaseAction falls back to auto-assigning any
  // available numbers for those.
  requestedShareNumbers Int[]  @default([])
  totalAmount   Decimal        @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  txId          String?
  screenshotUrl String?
  status        PurchaseStatus @default(PENDING)
  adminNote     String?
  referredById  String?
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime       @default(now())

  buyer       User     @relation(fields: [buyerId], references: [id])
  project     Project  @relation(fields: [projectId], references: [id])
  referredBy  User?    @relation("SharePurchaseReferrer", fields: [referredById], references: [id])
  processedBy User?    @relation("PurchaseProcessor", fields: [processedById], references: [id])
}

model ShareListing {
  id           String         @id @default(cuid())
  sellerId     String
  projectId    String
  quantity     Int
  // The specific share numbers (ShareCertificate.shareNumber) the seller is
  // offering — quantity is just this array's length. Empty on legacy rows
  // created before this field existed.
  listedShareNumbers Int[]    @default([])
  askingPrice  Decimal        @db.Decimal(12, 2)
  status       PurchaseStatus @default(PENDING)
  adminNote    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  seller User         @relation(fields: [sellerId], references: [id])
  project Project     @relation(fields: [projectId], references: [id])
  trades  ShareTrade[]
}

model ShareTrade {
  id            String         @id @default(cuid())
  listingId     String
  buyerId       String
  quantity      Int
  // The specific share numbers assigned from the listing's pool at approval
  // time (buyers only pick a quantity; admin approval fills this in from
  // whichever of the listing's listedShareNumbers aren't already claimed by
  // another approved trade against the same listing).
  tradedShareNumbers Int[]     @default([])
  totalAmount   Decimal        @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  txId          String?
  screenshotUrl String?
  status        PurchaseStatus @default(PENDING)
  adminNote     String?
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime       @default(now())

  listing     ShareListing @relation(fields: [listingId], references: [id])
  buyer       User         @relation("BuyerTrades", fields: [buyerId], references: [id])
  processedBy User?        @relation("TradeProcessor", fields: [processedById], references: [id])
}

enum ShareSize {
  SMALL
  BIG
}

model ShareBuyRequest {
  id            String         @id @default(cuid())
  buyerId       String
  name          String
  shareNumber   String
  size          ShareSize
  price         Decimal        @db.Decimal(12, 2)
  // Share SGD→BDT rate when the request was made, so the SGD equivalent
  // shown later never moves when admin changes the rate. Null on legacy rows.
  sgdRate       Decimal?       @db.Decimal(10, 4)
  preferredDate DateTime
  status        PurchaseStatus @default(PENDING)
  adminNote     String?
  // The buyer's persistent referrer (see commission.ts getReferredByAgentId),
  // captured at request time. Commission is only credited on approval, and
  // only if the admin has set a nonzero SHARE_BUY_REQUEST commission rate.
  referredById  String?
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime       @default(now())

  buyer       User  @relation("BuyRequestBuyer", fields: [buyerId], references: [id])
  referredBy  User? @relation("BuyRequestReferrer", fields: [referredById], references: [id])
  processedBy User? @relation("BuyRequestProcessor", fields: [processedById], references: [id])
}

// ─────────────────────────────────────────────
// WALLET
// ─────────────────────────────────────────────

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String       @id @default(cuid())
  walletId    String
  type        WalletTxType
  amount      Decimal      @db.Decimal(12, 2)
  description String
  referenceId String?
  balanceBefore Decimal    @db.Decimal(12, 2)
  balanceAfter  Decimal    @db.Decimal(12, 2)
  createdAt   DateTime     @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
}

model DepositRequest {
  id            String        @id @default(cuid())
  userId        String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  txId          String
  screenshotUrl String?
  status        DepositStatus @default(PENDING)
  adminNote     String?
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime      @default(now())

  user        User  @relation(fields: [userId], references: [id])
  processedBy User? @relation("DepositProcessor", fields: [processedById], references: [id])
}

model WithdrawalRequest {
  id            String        @id @default(cuid())
  userId        String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  accountNumber String
  accountName   String
  adminTxId     String?
  adminProofUrl String?
  status        DepositStatus @default(PENDING)
  adminNote     String?
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime      @default(now())

  user        User  @relation(fields: [userId], references: [id])
  processedBy User? @relation("WithdrawalProcessor", fields: [processedById], references: [id])
}

// User-to-user wallet transfer. The fee (admin setting, default 0) is paid by
// the sender on top of the amount; the recipient always gets the full amount.
model WalletTransfer {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  amount      Decimal  @db.Decimal(12, 2)
  fee         Decimal  @default(0) @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime @default(now())

  sender    User @relation("TransferSender", fields: [senderId], references: [id])
  recipient User @relation("TransferRecipient", fields: [recipientId], references: [id])

  @@index([senderId])
  @@index([recipientId])
}

// ─────────────────────────────────────────────
// AIR TICKET MODULE
// ─────────────────────────────────────────────

model AirTicketRequest {
  id                String        @id @default(cuid())
  userId            String
  origin            String
  destination       String
  departDate        DateTime
  returnDate        DateTime?
  passengers        Int           @default(1)
  preferredAirline  String?
  notes             String?
  ticketUrl         String?
  status            BookingStatus @default(PENDING)
  adminNote         String?
  price             Decimal?      @db.Decimal(10, 2)
  assignedManagerId String?
  referredById      String?
  processedById     String?
  processedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  assignedManager User?         @relation("AirTicketManagerAssignment", fields: [assignedManagerId], references: [id])
  referredBy      User?         @relation("AirTicketReferrer", fields: [referredById], references: [id])
  processedBy     User?         @relation("AirTicketProcessedBy", fields: [processedById], references: [id])
  checkoutItem    CheckoutItem?
}

// ─────────────────────────────────────────────
// TAXI RENT REQUEST
// ─────────────────────────────────────────────

model TaxiRequest {
  id                String        @id @default(cuid())
  userId            String
  pickupLocation    String
  destination       String
  date              DateTime
  passengerCount    Int           @default(1)
  vehicleType       String?
  notes             String?
  status            BookingStatus @default(PENDING)
  adminNote         String?
  price             Decimal?      @db.Decimal(10, 2)
  assignedVendorId  String?
  assignedManagerId String?
  referredById      String?
  processedById     String?
  processedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  assignedVendor  TaxiVendor?   @relation(fields: [assignedVendorId], references: [id])
  assignedManager User?         @relation("TaxiManagerAssignment", fields: [assignedManagerId], references: [id])
  referredBy      User?         @relation("TaxiReferrer", fields: [referredById], references: [id])
  processedBy     User?         @relation("TaxiProcessedBy", fields: [processedById], references: [id])
  checkoutItem    CheckoutItem?
}

model TaxiVendor {
  id          String   @id @default(cuid())
  name        String
  phone       String
  vehicleType String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taxiRequests TaxiRequest[]
}

// ─────────────────────────────────────────────
// CHECKOUT (multi-item WhatsApp-negotiated payment)
// ─────────────────────────────────────────────

model Checkout {
  id             String         @id @default(cuid())
  token          String         @unique
  userId         String
  subtotal       Decimal        @db.Decimal(12, 2)
  discountAmount Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal        @db.Decimal(12, 2)
  status         CheckoutStatus @default(DRAFT)
  paymentMethod  PaymentMethod?
  txId           String?
  screenshotUrl  String?
  adminNote      String?
  createdById    String
  processedById  String?
  processedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id])
  createdBy   User           @relation("CheckoutCreatedBy", fields: [createdById], references: [id])
  processedBy User?          @relation("CheckoutProcessedBy", fields: [processedById], references: [id])
  items       CheckoutItem[]
}

model CheckoutItem {
  id                 String           @id @default(cuid())
  checkoutId         String
  itemType           CheckoutItemType
  taxiRequestId      String?          @unique
  airTicketRequestId String?          @unique
  serviceRequestId   String?          @unique
  description        String
  quantity            Int             @default(1)
  unitPrice           Decimal         @db.Decimal(12, 2)
  lineTotal           Decimal         @db.Decimal(12, 2)
  createdAt           DateTime        @default(now())

  checkout         Checkout          @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  taxiRequest      TaxiRequest?      @relation(fields: [taxiRequestId], references: [id])
  airTicketRequest AirTicketRequest? @relation(fields: [airTicketRequestId], references: [id])
  serviceRequest   ServiceRequest?   @relation(fields: [serviceRequestId], references: [id])
}

// ─────────────────────────────────────────────
// BLOG
// ─────────────────────────────────────────────

model BlogCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  blogs Blog[]
}

model BlogTag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  blogs BlogTagRelation[]
}

model Blog {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  content         String
  excerpt         String?
  featuredImage   String?
  authorId        String
  categoryId      String?
  status          ContentStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  author   User          @relation(fields: [authorId], references: [id])
  category BlogCategory? @relation(fields: [categoryId], references: [id])
  tags     BlogTagRelation[]

  @@index([slug])
  @@index([status])
}

model BlogTagRelation {
  blogId String
  tagId  String

  blog Blog    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag  BlogTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
}

// ─────────────────────────────────────────────
// ISLAMIC KNOWLEDGE CENTER
// ─────────────────────────────────────────────

model Surah {
  id           String @id @default(cuid())
  number       Int    @unique
  arabicName   String
  englishName  String
  meaningName  String
  totalVerses  Int
  revelationType String
}

model Dua {
  id             String @id @default(cuid())
  title          String
  arabic         String
  transliteration String?
  translation    String
  category       String
  source         String?
  createdAt      DateTime @default(now())
}

model IslamicArticle {
  id        String        @id @default(cuid())
  title     String
  content   String
  excerpt   String?
  authorId  String
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  author User @relation(fields: [authorId], references: [id])
}

model PdfDocument {
  id          String        @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  category    String
  authorId    String
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())

  author User @relation(fields: [authorId], references: [id])
}

// ─────────────────────────────────────────────
// LOST & FOUND
// ─────────────────────────────────────────────

model LostFoundPost {
  id          String          @id @default(cuid())
  userId      String
  type        LostFoundType
  title       String
  description String
  location    String?
  images      String[]
  status      LostFoundStatus @default(OPEN)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([type, status])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  data       Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
}

// ─────────────────────────────────────────────
// SITE SETTINGS
// ─────────────────────────────────────────────

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// BANK RATES
// ─────────────────────────────────────────────

model BankRate {
  id        String   @id @default(cuid())
  bankName  String
  rate      Decimal  @db.Decimal(10, 4)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PAYMENT ACCOUNTS (admin-managed deposit receiving accounts)
// ─────────────────────────────────────────────

model PaymentAccount {
  id            String        @id @default(cuid())
  method        PaymentMethod
  label         String
  accountNumber String
  accountName   String?
  isActive      Boolean       @default(true)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ─────────────────────────────────────────────
// APPLY / SERVICE APPLICATIONS
// ─────────────────────────────────────────────

model ApplyService {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications     ApplyApplication[]
  serviceRequests  ServiceRequest[]
}

model ServiceRequest {
  id            String      @id @default(cuid())
  serviceId     String
  userId        String?     // nullable — submission doesn't require login; admin can link to a customer account for checkout bundling

  fullName      String
  phone         String
  email         String

  passportUrl   String?
  nidUrl        String?
  photoUrl      String?
  workPermitUrl String?
  otherUrl      String?

  status        ApplyStatus @default(PENDING)
  adminNote     String?
  referredById  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  service      ApplyService  @relation(fields: [serviceId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  referredBy   User?         @relation("ServiceReferrer", fields: [referredById], references: [id])
  checkoutItem CheckoutItem?

  @@index([serviceId])
  @@index([email])
}

model ApplyApplication {
  id             String      @id @default(cuid())
  userId         String
  serviceId      String
  resumeUrl      String?
  ePassportUrl   String?
  permitUrl      String?
  oldPassportUrl String?
  otherFileUrl   String?
  status         ApplyStatus @default(PENDING)
  adminNote      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user    User         @relation(fields: [userId], references: [id])
  service ApplyService @relation(fields: [serviceId], references: [id])

  @@index([userId])
  @@index([serviceId])
}

// ─────────────────────────────────────────────
// ALARM / REMINDER SYSTEM (10 slots, slot 1 free)
// ─────────────────────────────────────────────

model Reminder {
  id         String    @id @default(cuid())
  userId     String
  slotIndex  Int       // 1 to 10
  isUnlocked Boolean   @default(false)
  title      String?
  note       String?
  remindAt   DateTime?
  // IANA timezone id (e.g. "Asia/Dhaka") the user picked via a country dropdown
  // — remindAt is converted to/from this zone instead of the browser's local
  // offset. Null on legacy rows = assume Asia/Singapore, the old hardcoded behavior.
  timezone   String?
  channel    String    @default("WHATSAPP") // "WHATSAPP", "GMAIL", "BOTH"
  isActive   Boolean   @default(true)
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slotIndex])
  @@index([userId])
}

// ─────────────────────────────────────────────
// FORUM / GROUP CHAT
// ─────────────────────────────────────────────

model ForumTopic {
  id        String       @id @default(cuid())
  userId    String
  title     String
  content   String
  category  String       @default("General")
  views     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies ForumReply[]

  @@index([category])
  @@index([userId])
}

model ForumReply {
  id        String     @id @default(cuid())
  topicId   String
  userId    String
  content   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  topic ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// PICK & PUT (traveler luggage space, charged per kg)
// ─────────────────────────────────────────────

enum TripDirection {
  SG_TO_BD
  BD_TO_SG
}

enum PickPutTripStatus {
  PENDING // awaiting admin approval
  OPEN // approved, accepting bookings
  CLOSED // no longer taking bookings
  REJECTED
}

enum PickPutBookingStatus {
  PENDING // paid into escrow, waiting for traveler/admin to accept
  ACCEPTED
  DELIVERED // traveler has been paid
  REJECTED // refunded
  CANCELLED // refunded
}

// Admin-set per-kg rate for travel dates in [startDate, endDate]. A null
// direction covers both directions; when several match, the newest wins.
model PickPutRate {
  id        String         @id @default(cuid())
  direction TripDirection?
  startDate DateTime       @db.Date
  endDate   DateTime       @db.Date
  ratePerKg Decimal        @db.Decimal(10, 2)
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([startDate, endDate])
}

// A traveler ("Pick") offering spare luggage capacity on one flight.
model PickPutTrip {
  id         String            @id @default(cuid())
  travelerId String
  direction  TripDirection
  travelDate DateTime          @db.Date
  flightInfo String?
  totalKg    Decimal           @db.Decimal(6, 2)
  bookedKg   Decimal           @default(0) @db.Decimal(6, 2)
  // Locked from the PickPutRate for travelDate when the trip is created
  // (admin may adjust it on approval). Bookings copy it, so later rate
  // changes never touch existing trips or bookings.
  ratePerKg  Decimal           @db.Decimal(10, 2)
  notes      String?
  status     PickPutTripStatus @default(PENDING)
  adminNote  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  traveler User             @relation(fields: [travelerId], references: [id])
  bookings PickPutBooking[]

  @@index([status, travelDate])
  @@index([travelerId])
}

// A customer ("Put") sending items with a traveler. Paid from the wallet at
// booking time and held by the platform until delivery (paid out to the
// traveler) or rejection/cancellation (refunded to the customer).
model PickPutBooking {
  id              String               @id @default(cuid())
  tripId          String
  customerId      String
  weightKg        Decimal              @db.Decimal(6, 2)
  ratePerKg       Decimal              @db.Decimal(10, 2)
  totalAmount     Decimal              @db.Decimal(12, 2)
  itemDescription String
  receiverName    String
  receiverPhone   String
  receiverAddress String?
  status          PickPutBookingStatus @default(PENDING)
  adminNote       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  trip     PickPutTrip @relation(fields: [tripId], references: [id])
  customer User        @relation(fields: [customerId], references: [id])

  @@index([tripId])
  @@index([customerId])
}
